# Copy to .env (git-ignored) or export in your shell. Never commit real values.
# The code reads credentials only from environment variables; it does not load .env automatically.

# Gemini Developer API key (only needed for provider.name: gemini)
GEMINI_API_KEY=

# Optional: root directory for relative video paths in reports.jsonl
# (overridden by --video-root; overrides data.video_root in the experiment config)
VIDEO_REPORT_VIDEO_ROOT=
